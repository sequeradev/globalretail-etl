# ==============================================================================
# Environment variables — COPY THIS TO .env AND FILL YOUR VALUES
# ==============================================================================

# -------- Airflow admin user --------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Required on Linux to avoid permission issues on mounted volumes.
# On macOS/Windows Docker Desktop you can leave it as 50000.
# Linux: run `echo -e "AIRFLOW_UID=$(id -u)"` and paste the value here.
AIRFLOW_UID=50000

# -------- MongoDB Atlas --------
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=globalretail
MONGODB_COLLECTION=fact_sales
